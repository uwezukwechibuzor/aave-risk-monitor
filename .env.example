GRAPHOPS_API_KEY=
# Ethereum mainnet RPC endpoint from GraphOps (see https://docs.graphops.xyz/graphcast/supported-networks)
# Format: https://gateway.thegraph.com/api/{API_KEY}/subgraphs/id/...
# For RPC: https://ethereum-mainnet.rpc.thegraph.com (authenticated via header)
GRAPHOPS_RPC_URL=https://mainnet.gateway.tenderly.co
GRAPHOPS_SUBSTREAMS_ENDPOINT=mainnet.eth.streamingfast.io:443
DATABASE_URL=postgresql://risk:risk@localhost:5432/risk
BACKFILL_DAYS=90
SNAPSHOT_INTERVAL_LIVE=3600
SNAPSHOT_INTERVAL_HISTORY=86400
MAX_RPC_CALLS_PER_RUN=50000
CONFIRMATIONS=12
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
